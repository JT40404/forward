# ---------- Public (sent to the browser) ----------
# A paid mainnet RPC (Helius, Triton, QuickNode...). The public RPC will rate-limit you.
# Lock the key to your domain in your RPC provider's dashboard.
NEXT_PUBLIC_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# mainnet-beta or devnet (Fee Forward swaps use Jupiter, which is mainnet only)
NEXT_PUBLIC_CLUSTER=mainnet-beta
# Priority fee in micro-lamports per compute unit
NEXT_PUBLIC_PRIORITY_MICROLAMPORTS=200000

# Anti-snipe fee schedule for new pools (basis points; 100 = 1%)
NEXT_PUBLIC_POOL_START_FEE_BPS=5000
NEXT_PUBLIC_POOL_END_FEE_BPS=100
NEXT_PUBLIC_POOL_FEE_PERIODS=60
NEXT_PUBLIC_POOL_FEE_DURATION_SECONDS=300

# Optional platform fee charged in SOL on each launch (leave blank to disable)
NEXT_PUBLIC_PLATFORM_FEE_WALLET=
NEXT_PUBLIC_PLATFORM_FEE_SOL=

# ---------- Server only ----------
# Pinata JWT for image + metadata uploads (https://app.pinata.cloud/developers/api-keys)
PINATA_JWT=
# Your Pinata gateway domain, e.g. yourname.mypinata.cloud (falls back to the public gateway)
PINATA_GATEWAY=

# Jupiter API key (optional; without it the free lite-api tier is used)
JUPITER_API_KEY=

# Upstash Redis for the public launch feed (Vercel Marketplace > Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Server-side RPC used to verify launches before listing them (can match the public one)
RPC_URL=
